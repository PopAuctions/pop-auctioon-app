    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.110.7",
    "aes-js": "^3.1.2",
    "amazon-ivs-chat-messaging": "^1.1.1",
    "base-64": "^1.0.0",
    "clsx": "^2.1.1",
    "expo": "~57.0.7",
