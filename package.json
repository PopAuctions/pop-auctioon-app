    "@types/base-64": "^1.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "open-cli": "^8.0.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "volta": {
    "node": "24.12.0",
    "pnpm": "11.15.1"
  }
